{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeductionGate",
  "type": "object",
  "required": ["id", "title", "prompt", "requiresClues", "slots", "onSolve"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "prompt": { "type": "string" },
    "requiresClues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All of these clues must be found before the gate may be attempted"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["before", "answer", "chips"],
        "properties": {
          "before": { "type": "string", "description": "Sentence text before the slot" },
          "after": { "type": "string", "description": "Sentence text after the slot" },
          "answer": { "type": "string", "description": "Exactly one chip text that satisfies this slot" },
          "chips": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "Correct chip + distractors; must contain answer"
          }
        }
      }
    },
    "onSolve": {
      "type": "object",
      "properties": {
        "flags": { "type": "array", "items": { "type": "string" } },
        "unlockRooms": { "type": "array", "items": { "type": "string" } },
        "dialogue": { "type": "string", "description": "Dialogue node id played on solve" },
        "endCard": { "type": "string", "description": "End-card id shown on solve (act close)" }
      }
    }
  }
}
