{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseRegistry -- the folders on the detective's desk",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "code", "title", "subtitle", "status", "slot", "accent", "difficulty", "location", "victim", "pitch", "memo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Must match the directory /content/cases/<id>/ that holds the case bundle." },
          "code": { "type": "string" },
          "title": { "type": "string" },
          "subtitle": { "type": "string" },
          "status": { "type": "string", "enum": ["available", "sealed", "cold", "soon"], "description": "available = playable now; sealed = rank-gated; cold = future cold case; soon = being authored." },
          "firstCase": { "type": "boolean", "description": "Marks the detective's first case (used by the intro memo framing)." },
          "slot": { "type": "integer", "description": "Desk slot / folder order." },
          "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "difficulty": { "type": "string" },
          "location": { "type": "string" },
          "victim": { "type": "string" },
          "pitch": { "type": "string" },
          "rankRequired": { "type": "string" },
          "memo": { "type": "array", "items": { "type": "string" }, "description": "Captain's memo shown on the folder's detail page." }
        }
      }
    }
  }
}
