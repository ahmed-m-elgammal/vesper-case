{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldContent -- the police precinct world that hosts every case",
  "type": "object",
  "required": [
    "detective",
    "intro",
    "exterior",
    "interior",
    "career",
    "people",
    "graphs"
  ],
  "properties": {
    "detective": {
      "type": "object",
      "required": [
        "name",
        "rank",
        "badge",
        "desk",
        "station",
        "tagline",
        "backstory"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "desk": {
          "type": "integer"
        },
        "station": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "backstory": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "intro": {
      "type": "object",
      "required": [
        "when",
        "lines"
      ],
      "properties": {
        "when": {
          "type": "string",
          "enum": [
            "first-station-entry"
          ]
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "career": {
      "type": "object",
      "description": "Promotion ladder: one rank up every N closed cases. Pure data -- adding ranks needs no code.",
      "required": [
        "explanation",
        "ranks"
      ],
      "properties": {
        "explanation": {
          "type": "string"
        },
        "ceremony": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ranks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "after"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "after": {
                "type": "integer",
                "minimum": 0,
                "description": "Closed cases required. Ranks[0] must be 0; thresholds must increase."
              },
              "note": {
                "type": "string",
                "description": "What the rank unlocks, shown on the service record."
              }
            }
          }
        }
      }
    },
    "exterior": {
      "$ref": "#/$defs/stationScene"
    },
    "interior": {
      "$ref": "#/$defs/stationScene"
    },
    "upper": {
      "$ref": "#/$defs/stationScene"
    },
    "people": {
      "type": "object",
      "description": "Station staff talkable via dialogue graphs (portrait, tint, names).",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "shortName",
          "initial",
          "tint"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "initial": {
            "type": "string"
          },
          "tint": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "portrait": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "One-line post, shown in conversation sheets."
          }
        }
      }
    },
    "graphs": {
      "type": "object",
      "description": "Dialogue graphs for station staff, same node/choice shape as case dialogue graphs.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "stationScene": {
      "type": "object",
      "required": [
        "art",
        "title",
        "ambientCaption",
        "hotspots"
      ],
      "properties": {
        "art": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "ambientCaption": {
          "type": "string"
        },
        "firstEntry": {
          "type": "object",
          "description": "Narration played once, the first time the player walks in (persisted via the world flag).",
          "required": [
            "flag",
            "lines"
          ],
          "properties": {
            "flag": {
              "type": "string",
              "pattern": "^seen:"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "hotspots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "spot",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "spot": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "World-space rect [x, y, w, h] on the 1920x1080 scene art."
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "door",
                  "files",
                  "dialogue",
                  "flavor",
                  "locked",
                  "career"
                ]
              },
              "to": {
                "type": "string",
                "enum": [
                  "exterior",
                  "interior",
                  "upper"
                ],
                "description": "door: which station level to enter"
              },
              "dialogue": {
                "type": "string",
                "description": "dialogue: graph id in world.graphs"
              },
              "line": {
                "type": "string",
                "description": "flavor/locked: toast line"
              }
            }
          }
        },
        "nav": {
          "type": "object",
          "description": "Walking geometry for this precinct level: walkable union, colliders, depth-sorted props, stand points.",
          "required": [
            "spawn",
            "walk"
          ],
          "properties": {
            "spawn": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "spawnNear": {
              "type": "object",
              "description": "Arrival point per origin level (falls back to spawn).",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "walk": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "Walkable rect [x, y, w, h]; overlaps connect."
              }
            },
            "colliders": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4,
                "description": "Solid footprint [x, y, w, h] of furniture baked into the art."
              }
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "img",
                  "x",
                  "y",
                  "w",
                  "h",
                  "base"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "img": {
                    "type": "string"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  },
                  "base": {
                    "type": "number",
                    "description": "Floor-line y used for depth sorting."
                  },
                  "solid": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "person": {
                    "type": "string",
                    "description": "world.people id when the prop is a character."
                  }
                }
              }
            },
            "standPoints": {
              "type": "object",
              "description": "Hotspot id -> where the detective stands before the interaction fires.",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "reach": {
              "type": "number",
              "description": "Interaction reach in world px."
            }
          }
        }
      }
    }
  }
}