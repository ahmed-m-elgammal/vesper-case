{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldContent -- the police precinct world that hosts every case",
  "type": "object",
  "required": ["detective", "intro", "exterior", "interior", "people", "graphs"],
  "properties": {
    "detective": {
      "type": "object",
      "required": ["name", "rank", "badge", "desk", "station", "tagline", "backstory"],
      "properties": {
        "name": { "type": "string" },
        "rank": { "type": "string" },
        "badge": { "type": "string" },
        "desk": { "type": "integer" },
        "station": { "type": "string" },
        "tagline": { "type": "string" },
        "backstory": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "intro": {
      "type": "object",
      "required": ["when", "lines"],
      "properties": {
        "when": { "type": "string", "enum": ["first-station-entry"] },
        "lines": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "exterior": { "$ref": "#/$defs/stationScene" },
    "interior": { "$ref": "#/$defs/stationScene" },
    "people": {
      "type": "object",
      "description": "Station staff talkable via dialogue graphs (portrait, tint, names).",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "shortName", "initial", "tint"],
        "properties": {
          "name": { "type": "string" },
          "shortName": { "type": "string" },
          "initial": { "type": "string" },
          "tint": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "portrait": { "type": "string" }
        }
      }
    },
    "graphs": {
      "type": "object",
      "description": "Dialogue graphs for station staff, same node/choice shape as case dialogue graphs.",
      "additionalProperties": { "type": "object" }
    }
  },
  "$defs": {
    "stationScene": {
      "type": "object",
      "required": ["art", "title", "ambientCaption", "hotspots"],
      "properties": {
        "art": { "type": "string" },
        "title": { "type": "string" },
        "ambientCaption": { "type": "string" },
        "hotspots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "spot", "label", "kind"],
            "properties": {
              "id": { "type": "string" },
              "spot": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4,
                "description": "World-space rect [x, y, w, h] on the 1920x1080 scene art."
              },
              "label": { "type": "string" },
              "kind": { "type": "string", "enum": ["door", "files", "dialogue", "flavor", "locked"] },
              "to": { "type": "string", "enum": ["exterior", "interior"], "description": "door: which station level to enter" },
              "dialogue": { "type": "string", "description": "dialogue: graph id in world.graphs" },
              "line": { "type": "string", "description": "flavor/locked: toast line" }
            }
          }
        }
      }
    }
  }
}
