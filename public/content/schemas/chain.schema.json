{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chain",
  "type": "object",
  "required": ["id", "name", "blurb", "clueIds"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "blurb": { "type": "string" },
    "clueIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
