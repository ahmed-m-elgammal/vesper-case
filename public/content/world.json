{
  "$schema": "./schemas/world.schema.json",
  "detective": {
    "name": "Elias Byrne",
    "rank": "Detective Grade I",
    "badge": "4613",
    "desk": 14,
    "station": "Old Town Precinct",
    "tagline": "Six weeks out of the records room. First case.",
    "backstory": [
      "Elias Byrne spent three years in the Old Town records room, shelving other people's cases -- and reading every one of them on the night shift. He passed the detective exam in spring, top of his intake, and the exam board said what exam boards always say: the boy reads too much.",
      "What actually got him the desk was a misfiled letter. An old arson file crossed his shelf twice under two names, and he wrote a one-page note about it that ended up on Captain Breche's desk with 'promote this one' scrawled across it in red.",
      "The arson case was the Lantern Alley Fire. Six dead, no arrest, 1931. It still sits in a grey box in the evidence room, and it is not his to open yet. He keeps the misfiled letter's carbon copy folded in his warrant card.",
      "Sergeant Hollis, who took his statement exam and drank his terrible coffee, calls him 'the squint' -- he reads rooms the way he read shelves: slowly, twice, and out of order."
    ]
  },
  "intro": {
    "when": "first-station-entry",
    "lines": [
      "OLD TOWN PRECINCT -- Monday, 8:41 in the morning. Rain since Friday, and the gutters have opinions.",
      "Six weeks ago your name went up on the exam board. Six weeks in the records room, shelving other people's cases.",
      "Today there is a desk with your name-plate on it. Desk 14, by the radiator. The chair still remembers the last man.",
      "You are Detective Elias Byrne. Grade I. Badge 4613. The ink on the warrant card is barely dry.",
      "Somewhere on that desk is a folder with your first case in it. Go and take it."
    ]
  },
  "career": {
    "explanation": "Ten clean closures move a detective up one grade. It is the oldest rule in the building -- typed once, crossed out twice, and finally pinned behind the duty board where nobody pretends they cannot see it.",
    "ceremony": [
      "The bullpen goes quiet the way it only does for two things: bad news and promotions.",
      "Captain Breche reads the commendation from the top step, and the room counts your closed files along with her.",
      "Sergeant Hollis whistles through his teeth. Constable Dewi applauds half a beat early, as always. Miss Quill does not look up, but she types the new rank into the duty roster before the applause has finished."
    ],
    "ranks": [
      {
        "id": "grade-1",
        "title": "Detective Grade I",
        "after": 0,
        "note": "The ground floor: house deaths, lost property, one folder at a time."
      },
      {
        "id": "grade-2",
        "title": "Detective Grade II",
        "after": 10,
        "note": "Opens the pier file -- and everything else the river keeps."
      },
      {
        "id": "grade-3",
        "title": "Detective Grade III",
        "after": 20,
        "note": "Cold cases. The grey boxes. The alley that has waited since 1931."
      },
      {
        "id": "inspector",
        "title": "Inspector",
        "after": 30,
        "note": "You start reading other people's shelves -- and signing other people's chits."
      },
      {
        "id": "chief-inspector",
        "title": "Chief Inspector",
        "after": 40,
        "note": "The floor answers to you on the nights Breche is at the commissioner's."
      },
      {
        "id": "superintendent",
        "title": "Superintendent",
        "after": 50,
        "note": "Nobody in the history of this precinct has got there and kept the squint."
      }
    ]
  },
