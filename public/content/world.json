  "upper": {
    "art": "/art/station_up.svg",
    "title": "Old Town Precinct -- the upper floor",
    "ambientCaption": "[the kettle ticks, the radio murmurs, rain on the glass]",
    "firstEntry": {
      "flag": "seen:upper",
      "lines": [
        "The stairs complain about the traffic. Up here it is quieter: the canteen, the archive, and the records room behind its signed keys.",
        "The kettle has a view of the whole floor. The radio murmurs to nobody. The shelves carry a fair copy of every case this precinct has closed since 1929.",
        "You shelved some of these yourself, on night shifts, with a torch held in your teeth. Walking this floor as a detective feels like hearing your own name read out of turn."
      ]
    },
